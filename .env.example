# Local: http://localhost:3000. Production: actual HTTPS domain.
# Empty/invalid values safely fall back to https://syscore-blond.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Enable only after operator/legal approval and end-to-end delivery verification.
LEAD_INTAKE_APPROVED=false
LEAD_DELIVERY=telegram
# Server only. Supply through hosting secret storage; never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alternative university/email/database gateway: HTTPS POST; JSON {accepted:true}.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Shared Redis REST endpoint with EVAL. Five submissions / ten minutes.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_SALT=
# Self-host only, behind a reverse proxy overwriting x-forwarded-for.
TRUST_PROXY=false
