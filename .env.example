# Canonical site URL without a trailing slash. Used by sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. All four values are required to enable lead delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTTPS Redis REST endpoint supporting EVAL (e.g. Upstash).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
LEAD_INTAKE_APPROVED=false
